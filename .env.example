# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Admin authentication
# Generate the password hash with: npm run auth:hash-password
AUTH_SECRET="replace-with-at-least-32-random-characters"
HELIOS_ADMIN_EMAIL="owner@example.com"
HELIOS_ADMIN_NAME="Helios Owner"
HELIOS_ADMIN_PASSWORD_HASH="scrypt:salt:hash"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Cloudflare Stream
# Keep the API token server-only. Grant only Account > Stream > Edit.
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# HDPhotoHub client portals
# Keep this server-only. Never expose it through a NEXT_PUBLIC_ variable.
HDPH_API_KEY=""
# Optional override for testing; production uses the Helios HDPhotoHub API URL by default.
HDPH_API_BASE_URL=""

# Secure client-portal verification emails
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
CAMPAIGN_EMAIL_FROM=""
CAMPAIGN_REPLY_TO=""
CAMPAIGN_UNSUBSCRIBE_SECRET=""
PORTAL_EMAIL_FROM="Helios Real Estate Media <portal@example.com>"

# Website inquiry notifications
INQUIRY_NOTIFICATION_EMAIL="hello@example.com"
INQUIRY_EMAIL_FROM="Helios Website <website@example.com>"
INQUIRY_NOTIFICATION_WEBHOOK_URL=""

# Blog Studio AI editorial assistant
OPENAI_API_KEY=""
OPENAI_BLOG_MODEL="gpt-5-mini"
# Optional Social Studio writing-model override. Falls back to OPENAI_BLOG_MODEL.
OPENAI_SOCIAL_MODEL="gpt-5-mini"

# Social Studio V1.8.1 official OAuth and direct publishing
# Generate a high-entropy production-only value; rotating it requires reconnecting accounts.
SOCIAL_TOKEN_ENCRYPTION_KEY=""
# Canonical HTTPS production origin, without a trailing slash.
SOCIAL_OAUTH_BASE_URL="https://www.heliosrealestatemedia.com"
NEXT_PUBLIC_SITE_URL="https://www.heliosrealestatemedia.com"
LEGACY_PUBLIC_HOSTS="heliosremedia.com,www.heliosremedia.com"
META_APP_ID=""
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Newsletter Studio
# Uses OPENAI_API_KEY and CRON_SECRET. Keep both server-only.
OPENAI_NEWSLETTER_MODEL="gpt-5-mini"
NEWSLETTER_NOTIFICATION_EMAIL=""

# Referral Studio
# Set to false to hide and disable V1.6 while production configuration is reviewed.
REFERRAL_STUDIO_ENABLED="true"
# Optional; defaults to OPENAI_NEWSLETTER_MODEL.
OPENAI_REFERRAL_MODEL="gpt-5-mini"

# Optional Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
