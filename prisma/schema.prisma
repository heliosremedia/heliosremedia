  updatedAt DateTime @updatedAt
}

model NewsletterJob {
  id String @id @default(cuid())

  editionId        String
  edition          NewsletterEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  type             NewsletterJobType
