  REGISTER
}

enum TeamMemberCategory {
  LEADERSHIP
  PRODUCTION
  POST_PRODUCTION
  CLIENT_CARE
  MARKETING
  OPERATIONS
}

model TeamMember {
  id String @id @default(cuid())

  name      String
  title     String
  biography String
  category  TeamMemberCategory @default(PRODUCTION)

  portraitStorageKey String?
  portraitUrl        String?
  portraitAlt        String?
  focalX             Float   @default(0.5)
  focalY             Float   @default(0.25)

  displayOrder Int     @default(0)
  visible      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, displayOrder])
  @@index([category, displayOrder])
}

model Project {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String?
  description      String?

  city          String?
  state         String?
  locationLabel String?
  projectType   String?
  propertyType  String?

  status       ProjectStatus @default(DRAFT)
  featured     Boolean       @default(false)
  displayOrder Int           @default(0)

  heroMediaId      String? @unique
  thumbnailMediaId String? @unique

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  heroMedia      Media? @relation("ProjectHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  thumbnailMedia Media? @relation("ProjectThumbnailMedia", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  media             Media[]                      @relation("ProjectMedia")
  details           ProjectDetails?
  services          ProjectService[]
  tags              ProjectTag[]
  homepagePlacement HomepageProject?
  previewLinks      ProjectPreviewLink[]
  collectionHeroes  ProjectMediaCollectionHero[]
  socialCampaigns   SocialCampaign[]

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([status, displayOrder])
}

model ProjectDetails {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  listingAgent     String?
  brokerage        String?
  builder          String?
  architect        String?
  interiorDesigner String?

  price        Decimal? @db.Decimal(14, 2)
  squareFeet   Int?
  bedrooms     Float?
  bathrooms    Float?
  lotSize      String?
  neighborhood String?

  // Internal-only lookup value. Never rendered on public project pages.
  propertyAddress String?

  propertyWebsiteUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation("ProjectMedia", fields: [projectId], references: [id], onDelete: Cascade)

  sourceType    MediaSourceType
  mediaCategory MediaCategory
  provider      ExternalProvider?

  storageKey       String?
  originalFilename String?
  mimeType         String?
  externalUrl      String?
  externalId       String?

  altText String?
  caption String?

  width       Int?
  height      Int?
  aspectRatio Float?
  fileSize    Int?

  focalX Float @default(0.5)
  focalY Float @default(0.5)

  displayOrder Int             @default(0)
  visibility   MediaVisibility @default(VISIBLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroForProject      Project?                    @relation("ProjectHeroMedia")
  thumbnailForProject Project?                    @relation("ProjectThumbnailMedia")
  homepageWorkCards   HomepageWorkCard[]
  collectionHero      ProjectMediaCollectionHero?
  featuredBlogPosts   BlogPost[]
  socialVariants      SocialVariantMedia[]

  @@index([projectId])
  @@index([projectId, displayOrder])
  @@index([projectId, visibility])
  @@index([mediaCategory])
  @@index([sourceType])
}

model ProjectMediaCollectionHero {
  projectId     String
  mediaCategory MediaCategory
  mediaId       String        @unique

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([projectId, mediaCategory])
  @@index([mediaCategory])
}

model Service {
  id                  String  @id @default(cuid())
  name                String
  slug                String  @unique
  description         String?
  // Retained for backward compatibility; public service imagery now comes
  // from each project's matching media-collection hero.
  heroImageStorageKey String?
  heroImageAlt        String?
  displayOrder        Int     @default(0)
  active              Boolean @default(true)

  projects         ProjectService[]
  inquiries        InquiryService[]
  homepageWorkCard HomepageWorkCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
}

model ProjectService {
  projectId String
  serviceId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([projectId, serviceId])
  @@index([serviceId])
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  projects ProjectTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([projectId, tagId])
  @@index([tagId])
}

model FaqCategory {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  faqs Faq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
}

model Faq {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  question     String
  answer       String
  displayOrder Int     @default(0)
  published    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, displayOrder])
  @@index([published])
  @@index([published, categoryId])
}

model Testimonial {
  id String @id @default(cuid())

  agentName   String
  jobTitle    String?
  brokerage   String?
  testimonial String

  photoStorageKey  String?
  photoUrl         String?
  photoAlt         String?
  sourceUrl        String?
  sourceProvider   String    @default("MANUAL")
  externalReviewId String?   @unique
  reviewerPhotoUrl String?
  reviewedAt       DateTime?

  focalX Float @default(0.5)
  focalY Float @default(0.2)
  rating Int   @default(5)

  displayOrder Int     @default(0)
  published    Boolean @default(false)
  featured     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, displayOrder])
  @@index([featured])
  @@index([sourceProvider, published, displayOrder])
}

model TrustedLogo {
  id String @id @default(cuid())

  organizationName String
  logoStorageKey   String?
  logoUrl          String?
  logoAlt          String?
  websiteUrl       String?

  monochrome     Boolean @default(true)
  displayColor   String  @default("#D8D3CC")
  displayOpacity Float   @default(0.68)
  displayScale   Float   @default(1)

  displayOrder Int     @default(0)
  published    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, displayOrder])
}

model HomepageProject {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  titleOverride String?
  displayOrder  Int     @default(0)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
}

model HomepageWorkCard {
  id        String  @id @default(cuid())
  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  titleOverride       String?
  destinationOverride String?
  displayOrder        Int     @default(0)
  active              Boolean @default(true)

  imageStorageKey String?
  imageUrl        String?
  imageAlt        String?

  mediaMode       HomepageCardMediaMode @default(IMAGE)
  featuredMediaId String?
  featuredMedia   Media?                @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)

  videoStorageKey String?
  videoUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@index([featuredMediaId])
}

