model BlogPost {
  id String @id @default(cuid())

  title    String
  slug     String  @unique
  excerpt  String?
  content  String
  author   String?
  category String?

  status      BlogPostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?

  featuredMediaId String?
  featuredMedia   Media?  @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)

  featuredImageStorageKey String?
  featuredImageUrl        String?
  featuredImageAlt        String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  socialCaption String?
  sourceLinks   Json?

  seriesId          String?
  series            BlogSeries?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  intendedPublishAt DateTime?
  aiGenerated       Boolean            @default(false)
  manualContent     Boolean            @default(false)
  generationNotes   Json?
  revisions         BlogPostRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([featuredMediaId])
  @@index([seriesId, intendedPublishAt])
}

model BlogSeries {
  id String @id @default(cuid())

  name             String
  purpose          String
  targetAudience   String
  cadence          BlogSeriesCadence @default(BIWEEKLY)
  generationHour   Int               @default(8)
  leadDays         Int               @default(7)
  nextGenerationAt DateTime?
  nextPublishAt    DateTime?
  timezone         String            @default("America/Denver")

  contentPillars   Json
  brandVoice       String
  prioritizeTopics String?
  avoidTopics      String?
  targetLength     Int              @default(1000)
  seoFocus         String?
  preferredCta     String?
  imagePreferences String?
  status           BlogSeriesStatus @default(ACTIVE)
  lastPillarIndex  Int              @default(-1)

  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, nextGenerationAt])
}

model BlogPostRevision {
  id String @id @default(cuid())

  postId         String
  post           BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  title          String
  excerpt        String?
  content        String
  seoTitle       String?
  seoDescription String?
  sourceLinks    Json?
  changeSummary  String
  aiGenerated    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([postId, createdAt])
}

model LocationPage {
  id String @id @default(cuid())

  slug           String @unique
  city           String
  state          String @default("Colorado")
  county         String
  seoTitle       String
  seoDescription String
  heroLead       String
  introduction   String
  marketTitle    String
  marketCopy     String
  localDetails   Json
  serviceArea    String

  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, displayOrder])
}

model ClientPortal {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  provider    ClientPortalProvider @default(HDPHOTOHUB)

  hdphGroupId     Int?
  loginUrl        String?
  registrationUrl String?
  bookingUrl      String?

  registrationEnabled Boolean @default(true)
  isDefault           Boolean @default(false)
  active              Boolean @default(true)
  displayOrder        Int     @default(0)

  challenges ClientPortalChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@index([provider])
}

model ClientPortalChallenge {
  id                 String                       @id @default(cuid())
  portalId           String
  portal             ClientPortal                 @relation(fields: [portalId], references: [id], onDelete: Cascade)
