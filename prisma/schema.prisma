model ReferralCampaign {
  id String @id @default(cuid())

  internalName  String
  publicTitle   String
  purpose       String
  status        ReferralCampaignStatus @default(DRAFT)
  audienceMode  ReferralAudienceMode
  audienceRules Json

  referralOffer          String?
  advocateReward         String?
  referredCustomerOffer  String?
  eligibilityRules       String?
  qualificationRules     String?
  rewardInstructions     String?
  maxRewardsPerAdvocate  Int?
  terms                  String
  senderName             String?
  senderEmail            String?
  replyTo                String?
  landingHeadline        String
  landingBody            String
  landingThankYou        String
  privacyNotice          String
  invitationSubject      String
  invitationPreviewText  String?
  invitationBody         String
  followUpConfiguration  Json
  communicationTemplates Json
  aiMetadata             Json?

  startsAt                   DateTime?
  endsAt                     DateTime?
  referralExpirationDays     Int       @default(90)
  rowVersion                 Int       @default(0)
  approvedRevisionId         String?   @unique
  activatedAt                DateTime?
  pausedAt                   DateTime?
  launchStartedAt            DateTime?
  launchCompletedAt          DateTime?
  launchFailedAt             DateTime?
  launchLeaseExpiresAt       DateTime?
  launchingAdminId           String?
  launchRevisionId           String?
  launchAttemptId            String?   @unique
  expectedAdvocateCount      Int?
  preparedAdvocateCount      Int       @default(0)
  preparedInvitationCount    Int       @default(0)
  preparedCommunicationCount Int       @default(0)
  launchBatch                Int       @default(0)
  lastLaunchError            String?

  createdById String
  createdBy   AdminUser @relation("ReferralCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)

  audiences        ReferralCampaignAudience[]
  advocates        ReferralAdvocate[]
  invitations      ReferralInvitation[]
  links            ReferralLink[]
  submissions      ReferralSubmission[]
  revisions        ReferralCampaignRevision[] @relation("ReferralCampaignRevisions")
  approvedRevision ReferralCampaignRevision?  @relation("ApprovedReferralRevision", fields: [approvedRevisionId], references: [id], onDelete: Restrict)
  communications   ReferralCommunication[]
  auditEvents      ReferralAuditEvent[]
  testTokens       ReferralTestToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([status, launchLeaseExpiresAt])
  @@index([createdById, createdAt])
}

model ReferralCampaignAudience {
  id String @id @default(cuid())

  campaignId String
  campaign   ReferralCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId    String?
  group      CommunicationGroup?  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  clientId   String?
  client     CommunicationClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  excluded   Boolean              @default(false)
  reason     String?

  createdAt DateTime @default(now())

  @@unique([campaignId, groupId, clientId, excluded])
  @@index([campaignId, excluded])
  @@index([groupId])
  @@index([clientId])
}

model ReferralAdvocate {
  id String @id @default(cuid())

  campaignId             String
  campaign               ReferralCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId               String
  client                 CommunicationClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recommendationReason   String?
  recommendationScore    Int?
  recommendationWarnings Json?
  dismissedAt            DateTime?
  includedAt             DateTime?

  invitations ReferralInvitation[]
  links       ReferralLink[]
  submissions ReferralSubmission[]
  rewards     ReferralReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, clientId])
  @@index([clientId, createdAt])
  @@index([campaignId, dismissedAt])
}

model ReferralInvitation {
  id String @id @default(cuid())

  campaignId         String
  campaign           ReferralCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  advocateId         String
  advocate           ReferralAdvocate         @relation(fields: [advocateId], references: [id], onDelete: Restrict)
  status             ReferralInvitationStatus @default(DRAFT)
  subject            String
  previewText        String?
  body               String
  approvedSnapshot   Json?
  scheduledAt        DateTime?
  sentAt             DateTime?
  providerMessageId  String?
  failureCode        String?
  failureMessage     String?
  followUpStoppedAt  DateTime?
  approvedRevisionId String?

  link           ReferralLink?
  communications ReferralCommunication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, advocateId, approvedRevisionId])
  @@index([campaignId, status, scheduledAt])
  @@index([advocateId, createdAt])
  @@index([providerMessageId])
}

model ReferralLink {
  id String @id @default(cuid())

  invitationId   String             @unique
  invitation     ReferralInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       ReferralCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advocateId     String
  advocate       ReferralAdvocate   @relation(fields: [advocateId], references: [id], onDelete: Restrict)
  tokenHash      String             @unique
  code           String             @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  visitCount     Int                @default(0)
  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?

  submissions ReferralSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advocateId, createdAt])
  @@index([campaignId, createdAt])
  @@index([code, expiresAt])
}

model ReferralSubmission {
  id String @id @default(cuid())

  campaignId String
  campaign   ReferralCampaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  advocateId String?
  advocate   ReferralAdvocate? @relation(fields: [advocateId], references: [id], onDelete: SetNull)
  linkId     String?
  link       ReferralLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)

  firstName              String
  lastName               String
  email                  String
  normalizedEmail        String
  phone                  String?
  normalizedPhone        String?
  preferredContactMethod String
  message                String?
  submittedBy            String
  consentAcknowledged    Boolean
  consentText            String
  consentedAt            DateTime
  ipHash                 String?
  userAgent              String?

  status            ReferralStatus            @default(SUBMITTED)
  attributionStatus ReferralAttributionStatus @default(CONFIRMED)
  attributionReason String?
  duplicateOfId     String?
  duplicateOf       ReferralSubmission?       @relation("ReferralDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        ReferralSubmission[]      @relation("ReferralDuplicates")

  matchedClientId String?
  matchedClient   CommunicationClient? @relation("ReferralMatchedClient", fields: [matchedClientId], references: [id], onDelete: SetNull)
  inquiryId       String?
  inquiry         Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  externalOrderId String?
  internalNotes   String?

  statusEvents   ReferralStatusEvent[]
  rewards        ReferralReward[]
  communications ReferralCommunication[]
  auditEvents    ReferralAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status, createdAt])
  @@index([advocateId, createdAt])
  @@index([normalizedEmail, createdAt])
  @@index([normalizedPhone, createdAt])
  @@index([attributionStatus, createdAt])
  @@index([inquiryId])
}

model ReferralStatusEvent {
  id String @id @default(cuid())

  submissionId String
  submission   ReferralSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromStatus   ReferralStatus?
  toStatus     ReferralStatus
  reason       String?
  actorId      String?
  actor        AdminUser?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
}

model ReferralReward {
  id String @id @default(cuid())

  submissionId      String
  submission        ReferralSubmission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  advocateId        String
  advocate          ReferralAdvocate     @relation(fields: [advocateId], references: [id], onDelete: Restrict)
